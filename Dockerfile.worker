FROM golang:1.25-bookworm AS builder

WORKDIR /app

# Copy dependency files and vendor directory
COPY go.mod go.sum ./
COPY vendor/ vendor/

# Copy source code
COPY . .

# Build the worker binary using vendored dependencies
RUN CGO_ENABLED=0 GOOS=linux go build -mod=vendor -o worker ./cmd/worker

FROM alpine:latest

WORKDIR /root/

# Copy the worker binary
COPY --from=builder /app/worker .

# Add ca-certificates for HTTPS requests
RUN apk --no-cache add ca-certificates

CMD ["./worker"]
